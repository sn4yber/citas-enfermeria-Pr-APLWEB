# Copia a .env para desarrollo local
SECRET_KEY=django-insecure-dev-only-change-in-production
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Render (producción) — configurar en el dashboard, no commitear valores reales:
# DEBUG=False
# DATABASE_URL=<Internal Database URL de PostgreSQL en Render>
# ALLOWED_HOSTS=.onrender.com
# CORS_ALLOWED_ORIGINS=https://citas-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://citas-api.onrender.com
