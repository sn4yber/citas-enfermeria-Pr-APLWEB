---
import MedicalLayout from '../../layouts/MedicalLayout.astro';
---

<style>
  .ctab-active {
    border-bottom: 2px solid #0f172a;
    color: #0f172a;
    background: #f8fafc;
  }
</style>

<MedicalLayout title="Mi Agenda">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-gray-900">Gestión de Agenda</h1>
        <p class="text-gray-500 font-medium mt-1">Organiza y visualiza tu horario de atención</p>
      </div>
      <div class="flex bg-gray-100/80 p-1 rounded-xl border border-gray-200">
        <button id="btnVistaDiaria" class="px-5 py-2.5 bg-white text-gray-900 rounded-lg shadow-sm text-sm font-semibold transition-all">Vista Diaria</button>
        <button id="btnVistaSemanal" class="px-5 py-2.5 text-gray-600 hover:text-gray-900 text-sm font-medium rounded-lg transition-all">Horario Semanal</button>
      </div>
    </div>

    <!-- VISTA DIARIA: Resumen general de citas -->
    <div id="vistaDiaria" class="space-y-6">
      <!-- Stats rápidas -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Citas</p>
          <p class="text-3xl font-light text-slate-800" id="statTotal">-</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Programadas</p>
          <p class="text-3xl font-light text-teal-600" id="statProgramadas">-</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Completadas</p>
          <p class="text-3xl font-light text-emerald-600" id="statCompletadas">-</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Canceladas</p>
          <p class="text-3xl font-light text-red-400" id="statCanceladas">-</p>
        </div>
      </div>

      <!-- Filtro por fecha (opcional) -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 flex items-center gap-4">
        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"></path></svg>
        <span class="text-sm font-medium text-gray-500">Filtrar por fecha:</span>
        <input type="date" id="fechaSelect" class="text-sm font-medium text-gray-700 bg-transparent border border-gray-200 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none cursor-pointer" />
        <button id="btnLimpiarFiltro" class="text-sm text-gray-400 hover:text-gray-600 transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-50">Limpiar</button>
      </div>

      <div id="citasContainer" class="space-y-4">
        <div class="text-center py-12 text-gray-400">
          <svg class="animate-spin h-8 w-8 mx-auto text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>
      </div>
    </div>

    <!-- VISTA SEMANAL (HORARIO) -->
    <div id="vistaSemanal" class="hidden">
      <!-- Navegación de semana -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <h3 class="text-lg font-semibold text-gray-800" id="semanaRango"></h3>
        <div class="flex items-center gap-2">
          <button id="btnSemanaAnterior" class="p-2 border border-gray-200 bg-white rounded-lg shadow-sm hover:bg-gray-50 transition text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </button>
          <button id="btnSemanaActual" class="px-4 py-2 border border-gray-200 bg-white rounded-lg shadow-sm text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">Semana Actual</button>
          <button id="btnSemanaSiguiente" class="p-2 border border-gray-200 bg-white rounded-lg shadow-sm hover:bg-gray-50 transition text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-4 sm:p-8 shadow-sm relative overflow-x-auto">
        
        <!-- Header del Horario -->
        <div class="flex justify-between items-center border-b border-gray-200 pb-4 mb-6 min-w-[800px]">
          <div class="flex items-center gap-4">
            <h2 class="text-3xl font-light tracking-wide text-gray-900">SEMANA</h2>
          </div>
          <h2 class="text-xl font-medium text-gray-400 uppercase tracking-widest">Atención Médica</h2>
        </div>

        <div class="flex min-w-[800px]">
          <!-- Sidebar Vertical Text -->
          <div class="w-12 bg-slate-50 border border-gray-200 rounded-l-xl flex items-center justify-center py-10 mr-4">
             <span class="transform -rotate-90 whitespace-nowrap text-xs font-semibold tracking-widest text-slate-500">AGENDA CLÍNICA</span>
          </div>

          <!-- Grid -->
          <div class="flex-1">
            <div id="gridContainer" class="border-t border-l border-gray-200 grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr] bg-white rounded-r-xl overflow-hidden">
              <!-- Renderizado dinámicamente -->
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ══ DRAWER CONSULTA MÉDICA ══════════════════════════════ -->
  <div id="consultaOverlay" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40" onclick="cerrarConsulta()"></div>
  <div id="consultaDrawer"
    class="fixed top-0 right-0 h-full w-full max-w-2xl bg-white shadow-2xl z-50 translate-x-full transition-transform duration-300 flex flex-col">

    <!-- Header -->
    <div class="px-6 py-4 border-b border-gray-100 flex items-start justify-between shrink-0 bg-white sticky top-0 z-10">
      <div>
        <h2 class="text-base font-bold text-gray-900">Consulta Médica</h2>
        <p class="text-sm text-gray-400 mt-0.5" id="drawerPacienteInfo"></p>
      </div>
      <button onclick="cerrarConsulta()" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-gray-50 mt-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Tabs de la consulta -->
    <div class="flex border-b border-gray-100 shrink-0 overflow-x-auto">
      <button onclick="switchConsultaTab('sv')" id="ctSV" class="ctab ctab-active px-4 py-3 text-xs font-bold whitespace-nowrap">Signos Vitales</button>
      <button onclick="switchConsultaTab('an')" id="ctAN" class="ctab px-4 py-3 text-xs font-medium text-gray-500 whitespace-nowrap hover:bg-gray-50">Anamnesis</button>
      <button onclick="switchConsultaTab('dx')" id="ctDX" class="ctab px-4 py-3 text-xs font-medium text-gray-500 whitespace-nowrap hover:bg-gray-50">Diagnóstico</button>
      <button onclick="switchConsultaTab('rx')" id="ctRX" class="ctab px-4 py-3 text-xs font-medium text-gray-500 whitespace-nowrap hover:bg-gray-50">Receta Médica</button>
      <button onclick="switchConsultaTab('lab')" id="ctLAB" class="ctab px-4 py-3 text-xs font-medium text-gray-500 whitespace-nowrap hover:bg-gray-50">Laboratorio</button>
      <button onclick="switchConsultaTab('rem')" id="ctREM" class="ctab px-4 py-3 text-xs font-medium text-gray-500 whitespace-nowrap hover:bg-gray-50">Remisión</button>
    </div>

    <!-- Body scrollable -->
    <div class="flex-1 overflow-y-auto">

      <!-- ── Signos Vitales ── -->
      <div id="tabSV" class="p-5 space-y-4">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Signos Vitales</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">TA (mmHg)</label>
            <input id="sv_ta" type="text" placeholder="120/80" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">FC (lpm)</label>
            <input id="sv_fc" type="number" placeholder="72" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">FR (rpm)</label>
            <input id="sv_fr" type="number" placeholder="16" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Temp (°C)</label>
            <input id="sv_temp" type="number" step="0.1" placeholder="36.5" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">SpO₂ (%)</label>
            <input id="sv_spo2" type="number" placeholder="98" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Peso (kg)</label>
            <input id="sv_peso" type="number" step="0.1" placeholder="70.0" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Talla (cm)</label>
            <input id="sv_talla" type="number" step="0.1" placeholder="170" class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Examen físico</label>
          <textarea id="sv_exfisico" rows="3" placeholder="Hallazgos del examen físico por sistemas..." class="sv-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
      </div>

      <!-- ── Anamnesis ── -->
      <div id="tabAN" class="hidden p-5 space-y-4">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Anamnesis e Historia</p>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Motivo de consulta <span class="text-red-400">*</span></label>
          <textarea id="an_motivo" rows="2" placeholder="Motivo principal de la consulta..." class="an-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Enfermedad actual (HEA)</label>
          <textarea id="an_hea" rows="4" placeholder="Descripción cronológica de la enfermedad actual, inicio, evolución, síntomas acompañantes..." class="an-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Antecedentes personales</label>
          <textarea id="an_antecedentes" rows="3" placeholder="Enfermedades previas, cirugías, alergias, medicamentos crónicos..." class="an-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Revisión por sistemas</label>
          <textarea id="an_revision" rows="3" placeholder="Cardiovascular, respiratorio, digestivo, neurológico, musculoesquelético..." class="an-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
      </div>

      <!-- ── Diagnóstico ── -->
      <div id="tabDX" class="hidden p-5 space-y-4">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Diagnóstico y Plan</p>
        <div class="grid grid-cols-3 gap-3">
          <div class="col-span-2">
            <label class="block text-xs font-semibold text-gray-500 mb-1">Diagnóstico principal <span class="text-red-400">*</span></label>
            <input id="dx_diag" type="text" placeholder="Nombre del diagnóstico..." class="dx-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">CIE-10</label>
            <input id="dx_cie10" type="text" placeholder="J00" class="dx-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none font-mono uppercase"/>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Tipo de diagnóstico</label>
          <div class="flex gap-2">
            <button onclick="setTipoDx('presuntivo', this)" id="dx_pres" class="tipodx-btn flex-1 py-2 text-xs font-semibold border-2 border-slate-900 bg-slate-900 text-white rounded-xl transition-all">Presuntivo</button>
            <button onclick="setTipoDx('confirmado', this)" id="dx_conf" class="tipodx-btn flex-1 py-2 text-xs font-semibold border-2 border-gray-200 text-gray-600 rounded-xl transition-all hover:border-gray-300">Confirmado</button>
            <button onclick="setTipoDx('descartado', this)" id="dx_desc" class="tipodx-btn flex-1 py-2 text-xs font-semibold border-2 border-gray-200 text-gray-600 rounded-xl transition-all hover:border-gray-300">Descartado</button>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Conducta / Plan de tratamiento</label>
          <textarea id="dx_conducta" rows="3" placeholder="Tratamiento indicado, medidas generales, interconsultas..." class="dx-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Indicaciones para el paciente</label>
          <textarea id="dx_indicaciones" rows="2" placeholder="Reposo, dieta, actividad física, signos de alarma..." class="dx-input w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none resize-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Próximo control</label>
          <input id="dx_control" type="date" class="dx-input px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none"/>
        </div>
      </div>

      <!-- ── Receta Médica ── -->
      <div id="tabRX" class="hidden p-5 space-y-4">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Receta Médica</p>
          <button onclick="addMedicamento()" class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-xl hover:bg-slate-800 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Agregar medicamento
          </button>
        </div>
        <div id="recetaList" class="space-y-3">
          <div class="text-center py-8 text-gray-300 border-2 border-dashed border-gray-200 rounded-2xl">
            <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <p class="text-xs">Sin medicamentos. Presione "Agregar medicamento".</p>
          </div>
        </div>
      </div>

      <!-- ── Laboratorio ── -->
      <div id="tabLAB" class="hidden p-5 space-y-4">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Órdenes de Laboratorio</p>
          <button onclick="addLab()" class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-xl hover:bg-slate-800 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Agregar examen
          </button>
        </div>
        <div id="labList" class="space-y-2">
          <div class="text-center py-8 text-gray-300 border-2 border-dashed border-gray-200 rounded-2xl">
            <svg class="w-8 h-8 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            <p class="text-xs">Sin exámenes. Presione "Agregar examen".</p>
          </div>
        </div>
      </div>

      <!-- ── Remisión a especialista ── -->
      <div id="tabREM" class="hidden p-5 space-y-4">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest">Remisión a Especialista</p>
        <div class="p-3 bg-amber-50 border border-amber-100 rounded-xl text-xs text-amber-700">
          Al guardar una remisión se crea una <strong>Orden Médica</strong> que el área administrativa tramita ante la EPS para su autorización.
        </div>
        <div id="remisionesActuales" class="space-y-2"></div>
        <div class="border border-dashed border-gray-200 rounded-2xl p-4 space-y-3" id="remFormContainer">
          <p class="text-xs font-bold text-gray-500">Nueva remisión</p>
          <div class="grid grid-cols-2 gap-3">
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-gray-500 mb-1">Especialidad requerida</label>
              <select id="rem_esp" class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-teal-500 outline-none">
                <option value="">Seleccionar especialidad...</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Vigencia (días)</label>
              <input id="rem_vigencia" type="number" value="30" min="1" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-teal-500 outline-none"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 mb-1">Prioridad</label>
              <select id="rem_prioridad" class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-teal-500 outline-none">
                <option value="normal">Normal (5 días hábiles)</option>
                <option value="urgente">Urgente</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Indicación clínica / motivo de remisión</label>
            <textarea id="rem_obs" rows="2" placeholder="Diagnóstico y motivo de la remisión para el especialista..." class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-teal-500 outline-none resize-none"></textarea>
          </div>
          <button onclick="agregarRemision()" class="w-full py-2.5 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-xl transition-colors">
            Agregar Remisión
          </button>
        </div>
      </div>

    </div><!-- /body -->

    <!-- Footer -->
    <div class="px-6 py-4 border-t border-gray-100 bg-white shrink-0">
      <div id="consultaError" class="hidden mb-3 p-3 text-xs text-red-600 bg-red-50 rounded-xl border border-red-100"></div>
      <div class="flex gap-3">
        <button onclick="cerrarConsulta()" class="px-5 py-3 border border-gray-200 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors text-sm">Cancelar</button>
        <button id="btnGuardarConsulta" onclick="guardarConsulta()"
          class="flex-1 py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl transition-colors text-sm flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Guardar Consulta y Completar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Emitir Orden Médica -->
  <div id="ordenModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden">
      <div class="p-5 border-b border-gray-100 flex justify-between items-start">
        <div>
          <h3 class="text-lg font-bold text-gray-900">Emitir Orden Médica</h3>
          <p class="text-sm text-gray-400 mt-0.5">Orden de remisión a especialista</p>
        </div>
        <button onclick="document.getElementById('ordenModal').classList.add('hidden')" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-50 transition-colors mt-0.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <input type="hidden" id="ordenPacienteId" />
        <input type="hidden" id="ordenCitaId" />

        <div class="p-3 bg-amber-50 border border-amber-100 rounded-xl text-sm text-amber-800">
          <strong>Flujo SGSSS:</strong> Al emitir la orden, el área administrativa la tramitará ante la EPS del paciente para su autorización.
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Especialidad requerida</label>
          <select id="ordenEspecialidad" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none text-gray-700 font-medium">
            <option value="">Seleccionar especialidad...</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Vigencia (días)</label>
            <input type="number" id="ordenVigencia" value="30" min="1" max="365"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none text-gray-700 font-medium" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Prioridad</label>
            <select id="ordenPrioridad" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none text-gray-700 font-medium">
              <option value="normal">Normal (5 días hábiles)</option>
              <option value="urgente">Urgente</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Diagnóstico e indicaciones clínicas</label>
          <textarea id="ordenObservaciones" rows="3" placeholder="CIE-10, diagnóstico presuntivo, indicaciones para el especialista..."
            class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 focus:bg-white outline-none text-gray-700 resize-none text-sm"></textarea>
        </div>

        <div id="ordenError" class="hidden p-3 text-sm text-red-600 bg-red-50 rounded-xl border border-red-100"></div>
      </div>
      <div class="p-5 border-t border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row justify-end gap-3">
        <button onclick="document.getElementById('ordenModal').classList.add('hidden')" class="px-5 py-2.5 bg-white border border-gray-200 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors text-sm">Cancelar</button>
        <button id="btnGuardarOrden" onclick="guardarOrden()" class="px-6 py-2.5 bg-teal-600 text-white font-bold rounded-xl hover:bg-teal-700 transition-colors text-sm flex items-center gap-2 justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Emitir Orden Médica
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Detalles Cita -->
  <div id="citaModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl overflow-hidden transform transition-all">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Detalles de la Cita
        </h3>
        <button id="closeModal" class="text-gray-400 hover:text-gray-600 bg-white shadow-sm border border-gray-100 rounded-full p-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6 space-y-6">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2">Paciente</p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-slate-100 text-slate-700 rounded-full flex items-center justify-center font-bold text-lg" id="modalIniciales"></div>
            <div>
              <p class="text-lg font-semibold text-gray-900 leading-tight" id="modalPaciente"></p>
              <p class="text-sm text-gray-500 mt-0.5 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <span id="modalTelefono"></span>
              </p>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
            <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-widest">Fecha</p>
            <p class="text-gray-900 font-medium mt-1" id="modalFecha"></p>
          </div>
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
            <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-widest">Hora</p>
            <p class="text-gray-900 font-medium mt-1" id="modalHora"></p>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Estado</p>
            <span id="modalEstado" class="inline-block px-2.5 py-1 rounded text-xs font-semibold uppercase tracking-wider"></span>
          </div>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2">Motivo de consulta</p>
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 text-gray-700 text-sm leading-relaxed" id="modalMotivo"></div>
        </div>
      </div>
      <div class="bg-gray-50/50 p-5 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-3">
        <button id="btnVerDiaria" class="px-5 py-2.5 bg-white border border-gray-200 shadow-sm text-gray-700 font-medium rounded-lg hover:bg-gray-50 hover:text-gray-900 transition-colors w-full sm:w-auto text-center">Modificar en diaria</button>
        <button id="btnCerrarModal" class="px-5 py-2.5 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition-colors w-full sm:w-auto text-center">Cerrar</button>
      </div>
    </div>
  </div>
</MedicalLayout>

<script>
  // @ts-nocheck
  const token = localStorage.getItem('token');
  const rol = localStorage.getItem('rol');
  
  if (!token || rol !== 'medico') {
    window.location.replace('/medical/login');
    throw new Error('No autorizado');
  }

  const API = 'http://localhost:8000/api';
  const headers = { 'Authorization': `Bearer ${token}` };
  
  // TABS LOGIC
  const btnDiaria = document.getElementById('btnVistaDiaria');
  const btnSemanal = document.getElementById('btnVistaSemanal');
  const vistaDiaria = document.getElementById('vistaDiaria');
  const vistaSemanal = document.getElementById('vistaSemanal');

  btnDiaria.addEventListener('click', () => {
    btnDiaria.classList.replace('text-gray-600', 'text-gray-900');
    btnDiaria.classList.replace('font-medium', 'font-semibold');
    btnDiaria.classList.add('bg-white', 'shadow-sm');
    
    btnSemanal.classList.replace('text-gray-900', 'text-gray-600');
    btnSemanal.classList.replace('font-semibold', 'font-medium');
    btnSemanal.classList.remove('bg-white', 'shadow-sm');
    
    vistaDiaria.classList.remove('hidden');
    vistaSemanal.classList.add('hidden');
  });

  btnSemanal.addEventListener('click', () => {
    btnSemanal.classList.replace('text-gray-600', 'text-gray-900');
    btnSemanal.classList.replace('font-medium', 'font-semibold');
    btnSemanal.classList.add('bg-white', 'shadow-sm');
    
    btnDiaria.classList.replace('text-gray-900', 'text-gray-600');
    btnDiaria.classList.replace('font-semibold', 'font-medium');
    btnDiaria.classList.remove('bg-white', 'shadow-sm');
    
    vistaSemanal.classList.remove('hidden');
    vistaDiaria.classList.add('hidden');
    loadWeeklyAgenda();
  });

  // DAILY VIEW LOGIC - Resumen general de todas las citas
  const today = new Date().toISOString().split('T')[0];
  let todasLasCitas = [];

  document.getElementById('fechaSelect').addEventListener('change', (e) => {
    renderCitas(e.target.value || null);
  });

  document.getElementById('btnLimpiarFiltro').addEventListener('click', () => {
    document.getElementById('fechaSelect').value = '';
    renderCitas(null);
  });

  function renderStats(citas) {
    document.getElementById('statTotal').textContent = citas.length;
    document.getElementById('statProgramadas').textContent = citas.filter(c => c.estado === 'programada').length;
    document.getElementById('statCompletadas').textContent = citas.filter(c => c.estado === 'completada').length;
    document.getElementById('statCanceladas').textContent = citas.filter(c => c.estado === 'cancelada').length;
  }

  function renderCitas(filtroFecha) {
    const container = document.getElementById('citasContainer');
    const citas = filtroFecha
      ? todasLasCitas.filter(c => c.fecha === filtroFecha)
      : todasLasCitas;

    if (citas.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
          <div class="w-16 h-16 bg-gray-50 border border-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <p class="text-gray-500 font-medium">No hay citas${filtroFecha ? ' para esta fecha' : ' registradas'}</p>
        </div>
      `;
      return;
    }

    // Agrupar por fecha
    const porFecha = {};
    citas.forEach(c => {
      if (!porFecha[c.fecha]) porFecha[c.fecha] = [];
      porFecha[c.fecha].push(c);
    });

    const TIPO_COLORS_MED = {
      general: 'bg-teal-50 text-teal-700 border-teal-200',
      especializada: 'bg-slate-100 text-slate-700 border-slate-200',
      prioritaria: 'bg-amber-50 text-amber-700 border-amber-200',
    };
    const TIPO_LABELS_MED = { general: 'Medicina General', especializada: 'Especialista', prioritaria: 'Prioritaria' };

    const estadoBadge = {
      'programada': `<span class="px-2.5 py-1 bg-teal-50 text-teal-700 border border-teal-100 rounded text-xs font-semibold uppercase tracking-wider">Programada</span>`,
      'completada': `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded text-xs font-semibold uppercase tracking-wider">Completada</span>`,
      'cancelada':  `<span class="px-2.5 py-1 bg-red-50 text-red-700 border border-red-100 rounded text-xs font-semibold uppercase tracking-wider">Cancelada</span>`,
      'no_asistio': `<span class="px-2.5 py-1 bg-amber-50 text-amber-700 border border-amber-100 rounded text-xs font-semibold uppercase tracking-wider">No Asistió</span>`
    };

    const getAcciones = (c) => {
      const tipoBadge = `<span class="px-2 py-0.5 border rounded-full text-xs font-semibold ${TIPO_COLORS_MED[c.tipo_cita] || TIPO_COLORS_MED.general}">${TIPO_LABELS_MED[c.tipo_cita] || c.tipo_cita}</span>`;
      if (c.estado !== 'programada') return `<div class="flex flex-wrap items-center gap-2">${tipoBadge} ${estadoBadge[c.estado] || ''}</div>`;
      const autBadge = c.autorizacion
        ? `<span class="px-2 py-1 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-full text-xs font-semibold">✓ Aut. ${c.autorizacion.numero_autorizacion}</span>`
        : '';
      return `
        <div class="flex flex-wrap items-center gap-2">
          ${tipoBadge}
          ${autBadge}
          <button onclick='abrirConsulta(${JSON.stringify(c).replace(/'/g,"\\'")})'
            class="flex items-center gap-1.5 px-4 py-2 bg-slate-900 text-white rounded-lg hover:bg-slate-800 text-sm font-semibold transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Atender Consulta
          </button>
          <button onclick="actualizarEstado(${c.id},'no_asistio')" class="px-3 py-2 bg-white border border-gray-200 text-gray-600 rounded-lg hover:bg-gray-50 text-sm font-medium transition-colors">No asistió</button>
          <button onclick="actualizarEstado(${c.id},'cancelada')" class="px-3 py-2 text-red-500 hover:bg-red-50 rounded-lg text-sm font-medium transition-colors">Cancelar</button>
        </div>
      `;
    };

    const formatFechaHeader = (fechaStr) => {
      const d = new Date(fechaStr + 'T00:00:00');
      if (fechaStr === today) return `Hoy — ${d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}`;
      return d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    };

    container.innerHTML = Object.keys(porFecha)
      .sort()
      .map(fecha => {
        const citasDelDia = porFecha[fecha].sort((a,b) => a.hora.localeCompare(b.hora));
        const esHoy = fecha === today;
        const esPasado = fecha < today;
        return `
          <div class="bg-white rounded-2xl shadow-sm border ${esHoy ? 'border-teal-200' : 'border-gray-100'} overflow-hidden">
            <div class="px-6 py-4 border-b ${esHoy ? 'bg-teal-50 border-teal-100' : esPasado ? 'bg-gray-50 border-gray-100' : 'bg-slate-50 border-gray-100'} flex items-center justify-between">
              <div class="flex items-center gap-3">
                ${esHoy ? `<span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse inline-block"></span>` : ''}
                <h3 class="font-semibold text-sm uppercase tracking-wider ${esHoy ? 'text-teal-800' : 'text-slate-700'}">${formatFechaHeader(fecha)}</h3>
              </div>
              <span class="text-xs font-medium text-gray-400">${citasDelDia.length} cita${citasDelDia.length !== 1 ? 's' : ''}</span>
            </div>
            <div class="divide-y divide-gray-50">
              ${citasDelDia.map(c => `
                <div class="flex flex-col md:flex-row md:items-center justify-between p-5 gap-4 hover:bg-gray-50/50 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-800 font-bold text-base shrink-0">
                      ${c.hora.substring(0,5)}
                    </div>
                    <div>
                      <p class="font-semibold text-gray-900 mb-0.5">${c.paciente?.first_name || ''} ${c.paciente?.last_name || ''}</p>
                      <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                        <span class="flex items-center gap-1.5">
                          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                          ${c.paciente?.telefono || 'Sin tel.'}
                        </span>
                        ${c.paciente?.eps ? `<span class="text-xs text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full border border-teal-100 font-medium">${c.paciente.eps.nombre}</span>` : ''}
                        ${c.paciente?.regimen ? `<span class="text-xs text-slate-500 capitalize">${c.paciente.regimen}</span>` : ''}
                        ${c.paciente?.numero_documento ? `<span class="text-xs text-gray-400">${c.paciente.tipo_documento} ${c.paciente.numero_documento}</span>` : ''}
                      </div>
                      ${c.motivo ? `<p class="text-xs text-gray-400 mt-1 truncate max-w-xs">${c.motivo}</p>` : ''}
                    </div>
                  </div>
                  <div class="flex flex-wrap items-center gap-2 md:justify-end">
                    ${getAcciones(c)}
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');
  }

  async function loadResumenCitas() {
    const res = await fetch(`${API}/citas/`, { headers });
    if (!res.ok) return;
    todasLasCitas = await res.json();
    todasLasCitas.sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora));
    renderStats(todasLasCitas);
    renderCitas(null);
  }

  window.actualizarEstado = async (id, estado) => {
    const res = await fetch(`${API}/citas/${id}/`, {
      method: 'PUT',
      headers,
      body: JSON.stringify({ estado, observaciones: '' })
    });
    if (res.ok) {
      await loadResumenCitas();
      const filtro = document.getElementById('fechaSelect').value;
      renderCitas(filtro || null);
      if (!vistaSemanal.classList.contains('hidden')) {
        loadWeeklyAgenda();
      }
    }
  };

  loadResumenCitas();

  // WEEKLY VIEW LOGIC
  const colors = ['bg-blue-50', 'bg-teal-50', 'bg-indigo-50', 'bg-purple-50', 'bg-cyan-50'];
  const borders = ['border-blue-200', 'border-teal-200', 'border-indigo-200', 'border-purple-200', 'border-cyan-200'];
  const texts = ['text-blue-800', 'text-teal-800', 'text-indigo-800', 'text-purple-800', 'text-cyan-800'];
  let citasSemanalesData = {};
  let currentWeekOffset = 0; // Offset in days

  function getMonday(d) {
    d = new Date(d);
    var day = d.getDay(),
        diff = d.getDate() - day + (day == 0 ? -6:1);
    return new Date(d.setDate(diff));
  }

  document.getElementById('btnSemanaAnterior').addEventListener('click', () => {
    currentWeekOffset -= 7;
    loadWeeklyAgenda();
  });
  
  document.getElementById('btnSemanaSiguiente').addEventListener('click', () => {
    currentWeekOffset += 7;
    loadWeeklyAgenda();
  });

  document.getElementById('btnSemanaActual').addEventListener('click', () => {
    currentWeekOffset = 0;
    loadWeeklyAgenda();
  });

  async function loadWeeklyAgenda() {
    const curr = new Date();
    curr.setDate(curr.getDate() + currentWeekOffset);
    const monday = getMonday(curr);
    
    let diasSemana = [];
    let promesasCitas = [];

    // Lunes a Viernes
    for(let i=0; i<5; i++) {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      const strDate = d.toISOString().split('T')[0];
      diasSemana.push({
        nombre: ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'][i],
        fecha: strDate
      });
      // Hacer requests por día
      promesasCitas.push(fetch(`${API}/citas/?fecha=${strDate}`, { headers }).then(r => r.json()));
    }

    document.getElementById('semanaRango').textContent = `Semana del ${diasSemana[0].fecha} al ${diasSemana[4].fecha}`;

    const citasPorDia = await Promise.all(promesasCitas);
    
    // Organizar citas por hora y día
    const horasTrabajo = [
      '08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00'
    ];
    
    const container = document.getElementById('gridContainer');
    let html = `
      <div class="border-b border-r border-gray-100 bg-slate-50 p-3"></div>
      ${diasSemana.map(d => `<div class="border-b border-r border-gray-100 bg-slate-50 p-3 flex flex-col items-center justify-center font-semibold text-[11px] tracking-widest text-slate-700 uppercase"><span class="mb-0.5">${d.nombre}</span><span class="text-slate-400 font-medium">${d.fecha.substring(5)}</span></div>`).join('')}
    `;

    citasSemanalesData = {};
    let colorIndex = 0;

    horasTrabajo.forEach((hora) => {
      html += `<div class="border-b border-r border-gray-100 bg-slate-50 h-20 flex items-center justify-center font-semibold text-xs text-slate-600">${hora}</div>`;
      
      diasSemana.forEach((diaInfo, dayIdx) => {
        const citasDelDia = citasPorDia[dayIdx] || [];
        const prefix = hora.split(':')[0];
        
        const citasEnFranja = citasDelDia.filter(c => c.hora.startsWith(prefix) && (c.estado === 'programada' || c.estado === 'completada'));
        
        if (citasEnFranja.length > 0) {
          const c = citasEnFranja[0];
          citasSemanalesData[c.id] = c;
          
          const idx = colorIndex % colors.length;
          const bgClass = colors[idx];
          const borderClass = borders[idx];
          const textClass = texts[idx];
          colorIndex++;
          
          html += `
            <div onclick="abrirModal(${c.id})" class="cursor-pointer border-b border-r border-gray-100 p-1.5 hover:bg-gray-50 transition-colors">
              <div class="h-full w-full ${bgClass} border ${borderClass} rounded-lg flex flex-col items-center justify-center ${textClass} hover:opacity-80 transition-opacity">
                <span class="text-[10px] font-bold mb-0.5">${c.hora.substring(0,5)}</span>
                <span class="text-[10px] font-semibold tracking-wide uppercase text-center px-1 truncate w-full">${c.paciente?.first_name || 'Paciente'}</span>
              </div>
            </div>
          `;
        } else {
          // Empty space
          html += `<div class="border-b border-r border-gray-100 bg-white hover:bg-slate-50/50 transition-colors"></div>`;
        }
      });
    });

    container.innerHTML = html;
  }

  // MODAL LOGIC
  const modal = document.getElementById('citaModal');
  const btnClose = document.getElementById('closeModal');
  const btnCerrarModal = document.getElementById('btnCerrarModal');
  const btnVerDiaria = document.getElementById('btnVerDiaria');

  window.abrirModal = (citaId) => {
    const cita = citasSemanalesData[citaId];
    if(!cita) return;

    const nombreCompleto = `${cita.paciente?.first_name || ''} ${cita.paciente?.last_name || ''}`.trim();
    document.getElementById('modalIniciales').textContent = nombreCompleto.substring(0, 1).toUpperCase() || 'P';
    document.getElementById('modalPaciente').textContent = nombreCompleto || 'Paciente Desconocido';
    document.getElementById('modalTelefono').textContent = `${cita.paciente?.telefono || 'Sin teléfono'}`;
    
    document.getElementById('modalFecha').textContent = cita.fecha;
    document.getElementById('modalHora').textContent = cita.hora.substring(0, 5);
    document.getElementById('modalMotivo').textContent = cita.motivo || 'Sin motivo registrado.';
    
    const spanEst = document.getElementById('modalEstado');
    spanEst.textContent = cita.estado;
    spanEst.className = `inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ` + 
      (cita.estado === 'programada' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200');

    btnVerDiaria.onclick = () => {
      modal.classList.add('hidden');
      document.getElementById('fechaSelect').value = cita.fecha;
      loadCitasDiarias(cita.fecha);
      btnDiaria.click();
    };

    modal.classList.remove('hidden');
  };

  const closeModalFunc = () => modal.classList.add('hidden');
  btnClose.addEventListener('click', closeModalFunc);
  btnCerrarModal.addEventListener('click', closeModalFunc);

  // ---- Orden Médica ----
  async function loadEspecialidadesOrden() {
    const res = await fetch(`${API}/especialidades/`);
    const lista = await res.json();
    const sel = document.getElementById('ordenEspecialidad');
    sel.innerHTML = '<option value="">Seleccionar especialidad...</option>';
    lista.forEach(e => {
      const opt = document.createElement('option');
      opt.value = e.id;
      opt.textContent = e.nombre;
      sel.appendChild(opt);
    });
  }
  loadEspecialidadesOrden();

  window.emitirOrden = (citaId, pacienteId) => {
    document.getElementById('ordenCitaId').value = citaId;
    document.getElementById('ordenPacienteId').value = pacienteId;
    document.getElementById('ordenObservaciones').value = '';
    document.getElementById('ordenError').classList.add('hidden');
    document.getElementById('ordenModal').classList.remove('hidden');
  };

  // ════ CONSULTA MÉDICA ════════════════════════════════════
  let citaActual = null;
  let tipoDxActual = 'presuntivo';
  let medicamentos = [];
  let laboratorios = [];
  let remisiones = [];

  const CTAB_ACTIVE = 'ctab ctab-active border-b-2 border-slate-900 text-slate-900 font-bold px-4 py-3 text-xs whitespace-nowrap';
  const CTAB_IDLE   = 'ctab px-4 py-3 text-xs font-medium text-gray-500 whitespace-nowrap hover:bg-gray-50';

  window.switchConsultaTab = (tab) => {
    ['sv','an','dx','rx','lab','rem'].forEach(t => {
      document.getElementById('tab'+t.toUpperCase())?.classList.add('hidden');
      const b = document.getElementById('ct'+t.toUpperCase());
      if (b) b.className = CTAB_IDLE;
    });
    document.getElementById('tab'+tab.toUpperCase())?.classList.remove('hidden');
    const ab = document.getElementById('ct'+tab.toUpperCase());
    if (ab) ab.className = CTAB_ACTIVE;
  };

  window.abrirConsulta = (cita) => {
    citaActual = cita;
    medicamentos = []; laboratorios = []; remisiones = [];
    const p = cita.paciente;
    document.getElementById('drawerPacienteInfo').textContent =
      `${p?.first_name||''} ${p?.last_name||''} · ${p?.eps?.nombre||''} · ${cita.fecha} ${cita.hora?.substring(0,5)}`;
    // Reset all fields
    ['sv_ta','sv_fc','sv_fr','sv_temp','sv_spo2','sv_peso','sv_talla','sv_exfisico',
     'an_motivo','an_hea','an_antecedentes','an_revision',
     'dx_diag','dx_cie10','dx_conducta','dx_indicaciones','dx_control'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    // Pre-fill motivo from appointment
    if (cita.motivo) document.getElementById('an_motivo').value = cita.motivo;
    tipoDxActual = 'presuntivo';
    setTipoDx('presuntivo', document.getElementById('dx_pres'));
    renderReceta(); renderLabs(); renderRemisiones();
    loadEspecialidadesRemision();
    switchConsultaTab('sv');
    document.getElementById('consultaError').classList.add('hidden');
    document.getElementById('consultaDrawer').classList.remove('translate-x-full');
    document.getElementById('consultaOverlay').classList.remove('hidden');
  };

  window.cerrarConsulta = () => {
    document.getElementById('consultaDrawer').classList.add('translate-x-full');
    document.getElementById('consultaOverlay').classList.add('hidden');
  };

  window.setTipoDx = (tipo, btn) => {
    tipoDxActual = tipo;
    const colors = { presuntivo: 'border-slate-900 bg-slate-900 text-white', confirmado: 'border-emerald-600 bg-emerald-600 text-white', descartado: 'border-red-500 bg-red-500 text-white' };
    ['dx_pres','dx_conf','dx_desc'].forEach(id => {
      document.getElementById(id).className = 'tipodx-btn flex-1 py-2 text-xs font-semibold border-2 border-gray-200 text-gray-600 rounded-xl transition-all hover:border-gray-300';
    });
    btn.className = `tipodx-btn flex-1 py-2 text-xs font-semibold border-2 rounded-xl transition-all ${colors[tipo]}`;
  };

  // ── Receta ────────────────────────────────────────────
  const FORMAS = ['tableta','cápsula','jarabe','ampolla','crema','gotas','inhalador','supositorio','otro'];

  window.addMedicamento = () => {
    medicamentos.push({ medicamento:'', concentracion:'', forma_farmaceutica:'tableta', dosis:'', frecuencia:'', duracion:'', cantidad:'', indicaciones:'' });
    renderReceta();
  };
  window.removeMed = (i) => { medicamentos.splice(i,1); renderReceta(); };

  function renderReceta() {
    const c = document.getElementById('recetaList');
    if (!medicamentos.length) {
      c.innerHTML = `<div class="text-center py-8 text-gray-300 border-2 border-dashed border-gray-200 rounded-2xl text-xs">Sin medicamentos. Presione "Agregar medicamento".</div>`;
      return;
    }
    c.innerHTML = medicamentos.map((m,i) => `
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Medicamento ${i+1}</span>
          <button onclick="removeMed(${i})" class="text-red-400 hover:text-red-600 text-xs font-medium">✕ Quitar</button>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div class="col-span-2">
            <input value="${m.medicamento}" oninput="medicamentos[${i}].medicamento=this.value" type="text" placeholder="Nombre del medicamento *"
              class="w-full px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none font-semibold"/>
          </div>
          <input value="${m.concentracion}" oninput="medicamentos[${i}].concentracion=this.value" type="text" placeholder="Concentración (ej: 500mg)"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
          <select onchange="medicamentos[${i}].forma_farmaceutica=this.value"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none">
            ${FORMAS.map(f=>`<option value="${f}" ${m.forma_farmaceutica===f?'selected':''}>${f.charAt(0).toUpperCase()+f.slice(1)}</option>`).join('')}
          </select>
          <input value="${m.dosis}" oninput="medicamentos[${i}].dosis=this.value" type="text" placeholder="Dosis (ej: 1 tableta) *"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
          <input value="${m.frecuencia}" oninput="medicamentos[${i}].frecuencia=this.value" type="text" placeholder="Frecuencia (ej: cada 8h) *"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
          <input value="${m.duracion}" oninput="medicamentos[${i}].duracion=this.value" type="text" placeholder="Duración (ej: 5 días) *"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
          <input value="${m.cantidad}" oninput="medicamentos[${i}].cantidad=this.value" type="text" placeholder="Cantidad (ej: 15 tabletas)"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
          <input value="${m.indicaciones}" oninput="medicamentos[${i}].indicaciones=this.value" type="text" placeholder="Indicaciones especiales"
            class="col-span-2 px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
        </div>
      </div>`).join('');
  }

  // ── Laboratorio ───────────────────────────────────────
  window.addLab = () => { laboratorios.push({ examen:'', indicacion:'', urgente: false }); renderLabs(); };
  window.removeLab = (i) => { laboratorios.splice(i,1); renderLabs(); };

  function renderLabs() {
    const c = document.getElementById('labList');
    if (!laboratorios.length) {
      c.innerHTML = `<div class="text-center py-8 text-gray-300 border-2 border-dashed border-gray-200 rounded-2xl text-xs">Sin exámenes. Presione "Agregar examen".</div>`;
      return;
    }
    c.innerHTML = laboratorios.map((l,i) => `
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 flex items-center gap-3">
        <div class="flex-1 grid grid-cols-2 gap-2">
          <input value="${l.examen}" oninput="laboratorios[${i}].examen=this.value" type="text" placeholder="Nombre del examen *"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none font-semibold"/>
          <input value="${l.indicacion}" oninput="laboratorios[${i}].indicacion=this.value" type="text" placeholder="Indicación clínica"
            class="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 outline-none"/>
        </div>
        <label class="flex items-center gap-1.5 text-xs font-semibold text-red-600 shrink-0 cursor-pointer">
          <input type="checkbox" ${l.urgente?'checked':''} onchange="laboratorios[${i}].urgente=this.checked" class="rounded"/> Urgente
        </label>
        <button onclick="removeLab(${i})" class="text-red-400 hover:text-red-600 text-xs font-medium shrink-0">✕</button>
      </div>`).join('');
  }

  // ── Remisión ──────────────────────────────────────────
  async function loadEspecialidadesRemision() {
    const res = await fetch(`${API}/especialidades/`);
    const lista = await res.json();
    const sel = document.getElementById('rem_esp');
    sel.innerHTML = '<option value="">Seleccionar especialidad...</option>';
    lista.forEach(e => {
      const o = document.createElement('option');
      o.value = e.id; o.textContent = e.nombre;
      sel.appendChild(o);
    });
  }

  window.agregarRemision = () => {
    const espId = document.getElementById('rem_esp').value;
    const espNombre = document.getElementById('rem_esp').selectedOptions[0]?.text || '';
    const vigencia = document.getElementById('rem_vigencia').value;
    const obs = document.getElementById('rem_obs').value;
    if (!espId) { alert('Seleccione una especialidad'); return; }
    remisiones.push({ especialidad_id: espId, especialidad_nombre: espNombre, vigencia_dias: vigencia, observaciones: obs });
    document.getElementById('rem_esp').value = '';
    document.getElementById('rem_obs').value = '';
    renderRemisiones();
  };
  window.removeRemision = (i) => { remisiones.splice(i,1); renderRemisiones(); };

  function renderRemisiones() {
    const c = document.getElementById('remisionesActuales');
    if (!remisiones.length) { c.innerHTML = ''; return; }
    c.innerHTML = remisiones.map((r,i) => `
      <div class="flex items-center justify-between p-3 bg-teal-50 border border-teal-100 rounded-xl">
        <div>
          <p class="text-sm font-semibold text-teal-800">${r.especialidad_nombre}</p>
          <p class="text-xs text-teal-600">Vigencia: ${r.vigencia_dias} días ${r.observaciones ? '· '+r.observaciones.substring(0,50) : ''}</p>
        </div>
        <button onclick="removeRemision(${i})" class="text-red-400 hover:text-red-600 text-xs ml-2 font-medium">✕</button>
      </div>`).join('');
  }

  // ── Guardar consulta ──────────────────────────────────
  window.guardarConsulta = async () => {
    const btn = document.getElementById('btnGuardarConsulta');
    const errDiv = document.getElementById('consultaError');
    const motivo = document.getElementById('an_motivo').value.trim();
    const diag = document.getElementById('dx_diag').value.trim();
    if (!motivo) { errDiv.textContent = 'El motivo de consulta es obligatorio (pestaña Anamnesis).'; errDiv.classList.remove('hidden'); switchConsultaTab('an'); return; }
    if (!diag) { errDiv.textContent = 'El diagnóstico principal es obligatorio (pestaña Diagnóstico).'; errDiv.classList.remove('hidden'); switchConsultaTab('dx'); return; }

    // Validate receta
    for (const m of medicamentos) {
      if (!m.medicamento || !m.dosis || !m.frecuencia || !m.duracion) {
        errDiv.textContent = 'Complete todos los campos obligatorios de la receta (medicamento, dosis, frecuencia, duración).';
        errDiv.classList.remove('hidden'); switchConsultaTab('rx'); return;
      }
    }
    for (const l of laboratorios) {
      if (!l.examen) { errDiv.textContent = 'Complete el nombre del examen de laboratorio.'; errDiv.classList.remove('hidden'); switchConsultaTab('lab'); return; }
    }

    btn.textContent = 'Guardando...'; btn.disabled = true;
    errDiv.classList.add('hidden');

    const payload = {
      cita_id: citaActual.id,
      motivo_consulta: motivo,
      enfermedad_actual: document.getElementById('an_hea').value,
      antecedentes_personales: document.getElementById('an_antecedentes').value,
      revision_sistemas: document.getElementById('an_revision').value,
      tension_arterial: document.getElementById('sv_ta').value,
      frecuencia_cardiaca: parseInt(document.getElementById('sv_fc').value) || null,
      frecuencia_respiratoria: parseInt(document.getElementById('sv_fr').value) || null,
      temperatura: parseFloat(document.getElementById('sv_temp').value) || null,
      saturacion_o2: parseInt(document.getElementById('sv_spo2').value) || null,
      peso_kg: parseFloat(document.getElementById('sv_peso').value) || null,
      talla_cm: parseFloat(document.getElementById('sv_talla').value) || null,
      examen_fisico: document.getElementById('sv_exfisico').value,
      diagnostico_principal: diag,
      codigo_cie10: document.getElementById('dx_cie10').value.toUpperCase(),
      tipo_diagnostico: tipoDxActual,
      conducta: document.getElementById('dx_conducta').value,
      indicaciones: document.getElementById('dx_indicaciones').value,
      proximo_control: document.getElementById('dx_control').value || null,
      receta: medicamentos,
      laboratorios: laboratorios,
    };

    const res = await fetch(`${API}/historias/`, {
      method: 'POST',
      headers: { ...headers, 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const d = await res.json();
      errDiv.textContent = d.error || JSON.stringify(d);
      errDiv.classList.remove('hidden');
      btn.textContent = 'Guardar Consulta y Completar'; btn.disabled = false;
      return;
    }

    // Crear remisiones (órdenes médicas) en paralelo
    for (const r of remisiones) {
      await fetch(`${API}/ordenes-medicas/`, {
        method: 'POST',
        headers: { ...headers, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: citaActual.paciente?.id,
          especialidad_solicitada_id: Number(r.especialidad_id),
          cita_origen_id: citaActual.id,
          vigencia_dias: Number(r.vigencia_dias) || 30,
          observaciones: r.observaciones,
        }),
      });
    }

    cerrarConsulta();
    await loadResumenCitas();
    btn.textContent = 'Guardar Consulta y Completar'; btn.disabled = false;
  };

  window.guardarOrden = async () => {
    const btn = document.getElementById('btnGuardarOrden');
    const errDiv = document.getElementById('ordenError');
    const espId = document.getElementById('ordenEspecialidad').value;
    if (!espId) { errDiv.textContent = 'Seleccione una especialidad.'; errDiv.classList.remove('hidden'); return; }

    btn.textContent = 'Emitiendo...';
    btn.disabled = true;

    const res = await fetch(`${API}/ordenes-medicas/`, {
      method: 'POST',
      headers: { ...headers, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        paciente_id: Number(document.getElementById('ordenPacienteId').value),
        especialidad_solicitada_id: Number(espId),
        cita_origen_id: Number(document.getElementById('ordenCitaId').value),
        vigencia_dias: Number(document.getElementById('ordenVigencia').value) || 30,
        observaciones: document.getElementById('ordenObservaciones').value,
      }),
    });

    if (res.ok) {
      document.getElementById('ordenModal').classList.add('hidden');
      await loadResumenCitas();
    } else {
      const data = await res.json();
      errDiv.textContent = data.error || 'Error al emitir la orden.';
      errDiv.classList.remove('hidden');
    }
    btn.textContent = 'Emitir Orden';
    btn.disabled = false;
  };
</script>
