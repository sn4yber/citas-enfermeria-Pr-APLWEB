---
import MedicalLayout from '../../layouts/MedicalLayout.astro';
---

<MedicalLayout title="Mi Agenda">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-gray-900">Gestión de Agenda</h1>
        <p class="text-gray-500 font-medium mt-1">Organiza y visualiza tu horario de atención</p>
      </div>
      <div class="flex bg-gray-100/80 p-1 rounded-xl border border-gray-200">
        <button id="btnVistaDiaria" class="px-5 py-2.5 bg-white text-gray-900 rounded-lg shadow-sm text-sm font-semibold transition-all">Vista Diaria</button>
        <button id="btnVistaSemanal" class="px-5 py-2.5 text-gray-600 hover:text-gray-900 text-sm font-medium rounded-lg transition-all">Horario Semanal</button>
      </div>
    </div>

    <!-- VISTA DIARIA: Resumen general de citas -->
    <div id="vistaDiaria" class="space-y-6">
      <!-- Stats rápidas -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Citas</p>
          <p class="text-3xl font-light text-slate-800" id="statTotal">-</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Programadas</p>
          <p class="text-3xl font-light text-teal-600" id="statProgramadas">-</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Completadas</p>
          <p class="text-3xl font-light text-emerald-600" id="statCompletadas">-</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Canceladas</p>
          <p class="text-3xl font-light text-red-400" id="statCanceladas">-</p>
        </div>
      </div>

      <!-- Filtro por fecha (opcional) -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 flex items-center gap-4">
        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"></path></svg>
        <span class="text-sm font-medium text-gray-500">Filtrar por fecha:</span>
        <input type="date" id="fechaSelect" class="text-sm font-medium text-gray-700 bg-transparent border border-gray-200 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none cursor-pointer" />
        <button id="btnLimpiarFiltro" class="text-sm text-gray-400 hover:text-gray-600 transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-50">Limpiar</button>
      </div>

      <div id="citasContainer" class="space-y-4">
        <div class="text-center py-12 text-gray-400">
          <svg class="animate-spin h-8 w-8 mx-auto text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>
      </div>
    </div>

    <!-- VISTA SEMANAL (HORARIO) -->
    <div id="vistaSemanal" class="hidden">
      <!-- Navegación de semana -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <h3 class="text-lg font-semibold text-gray-800" id="semanaRango"></h3>
        <div class="flex items-center gap-2">
          <button id="btnSemanaAnterior" class="p-2 border border-gray-200 bg-white rounded-lg shadow-sm hover:bg-gray-50 transition text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </button>
          <button id="btnSemanaActual" class="px-4 py-2 border border-gray-200 bg-white rounded-lg shadow-sm text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">Semana Actual</button>
          <button id="btnSemanaSiguiente" class="p-2 border border-gray-200 bg-white rounded-lg shadow-sm hover:bg-gray-50 transition text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-4 sm:p-8 shadow-sm relative overflow-x-auto">
        
        <!-- Header del Horario -->
        <div class="flex justify-between items-center border-b border-gray-200 pb-4 mb-6 min-w-[800px]">
          <div class="flex items-center gap-4">
            <h2 class="text-3xl font-light tracking-wide text-gray-900">SEMANA</h2>
          </div>
          <h2 class="text-xl font-medium text-gray-400 uppercase tracking-widest">Atención Médica</h2>
        </div>

        <div class="flex min-w-[800px]">
          <!-- Sidebar Vertical Text -->
          <div class="w-12 bg-slate-50 border border-gray-200 rounded-l-xl flex items-center justify-center py-10 mr-4">
             <span class="transform -rotate-90 whitespace-nowrap text-xs font-semibold tracking-widest text-slate-500">AGENDA CLÍNICA</span>
          </div>

          <!-- Grid -->
          <div class="flex-1">
            <div id="gridContainer" class="border-t border-l border-gray-200 grid grid-cols-[100px_1fr_1fr_1fr_1fr_1fr] bg-white rounded-r-xl overflow-hidden">
              <!-- Renderizado dinámicamente -->
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Modal Detalles Cita -->
  <div id="citaModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl overflow-hidden transform transition-all">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Detalles de la Cita
        </h3>
        <button id="closeModal" class="text-gray-400 hover:text-gray-600 bg-white shadow-sm border border-gray-100 rounded-full p-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6 space-y-6">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2">Paciente</p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-slate-100 text-slate-700 rounded-full flex items-center justify-center font-bold text-lg" id="modalIniciales"></div>
            <div>
              <p class="text-lg font-semibold text-gray-900 leading-tight" id="modalPaciente"></p>
              <p class="text-sm text-gray-500 mt-0.5 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <span id="modalTelefono"></span>
              </p>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
            <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-widest">Fecha</p>
            <p class="text-gray-900 font-medium mt-1" id="modalFecha"></p>
          </div>
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
            <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-widest">Hora</p>
            <p class="text-gray-900 font-medium mt-1" id="modalHora"></p>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Estado</p>
            <span id="modalEstado" class="inline-block px-2.5 py-1 rounded text-xs font-semibold uppercase tracking-wider"></span>
          </div>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2">Motivo de consulta</p>
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 text-gray-700 text-sm leading-relaxed" id="modalMotivo"></div>
        </div>
      </div>
      <div class="bg-gray-50/50 p-5 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-3">
        <button id="btnVerDiaria" class="px-5 py-2.5 bg-white border border-gray-200 shadow-sm text-gray-700 font-medium rounded-lg hover:bg-gray-50 hover:text-gray-900 transition-colors w-full sm:w-auto text-center">Modificar en diaria</button>
        <button id="btnCerrarModal" class="px-5 py-2.5 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition-colors w-full sm:w-auto text-center">Cerrar</button>
      </div>
    </div>
  </div>
</MedicalLayout>

<script>
  // @ts-nocheck
  const token = localStorage.getItem('token');
  const rol = localStorage.getItem('rol');
  
  if (!token || rol !== 'medico') {
    window.location.replace('/medical/login');
    throw new Error('No autorizado');
  }

  const API = 'http://localhost:8000/api';
  const headers = { 'Authorization': `Bearer ${token}` };
  
  // TABS LOGIC
  const btnDiaria = document.getElementById('btnVistaDiaria');
  const btnSemanal = document.getElementById('btnVistaSemanal');
  const vistaDiaria = document.getElementById('vistaDiaria');
  const vistaSemanal = document.getElementById('vistaSemanal');

  btnDiaria.addEventListener('click', () => {
    btnDiaria.classList.replace('text-gray-600', 'text-gray-900');
    btnDiaria.classList.replace('font-medium', 'font-semibold');
    btnDiaria.classList.add('bg-white', 'shadow-sm');
    
    btnSemanal.classList.replace('text-gray-900', 'text-gray-600');
    btnSemanal.classList.replace('font-semibold', 'font-medium');
    btnSemanal.classList.remove('bg-white', 'shadow-sm');
    
    vistaDiaria.classList.remove('hidden');
    vistaSemanal.classList.add('hidden');
  });

  btnSemanal.addEventListener('click', () => {
    btnSemanal.classList.replace('text-gray-600', 'text-gray-900');
    btnSemanal.classList.replace('font-medium', 'font-semibold');
    btnSemanal.classList.add('bg-white', 'shadow-sm');
    
    btnDiaria.classList.replace('text-gray-900', 'text-gray-600');
    btnDiaria.classList.replace('font-semibold', 'font-medium');
    btnDiaria.classList.remove('bg-white', 'shadow-sm');
    
    vistaSemanal.classList.remove('hidden');
    vistaDiaria.classList.add('hidden');
    loadWeeklyAgenda();
  });

  // DAILY VIEW LOGIC - Resumen general de todas las citas
  const today = new Date().toISOString().split('T')[0];
  let todasLasCitas = [];

  document.getElementById('fechaSelect').addEventListener('change', (e) => {
    renderCitas(e.target.value || null);
  });

  document.getElementById('btnLimpiarFiltro').addEventListener('click', () => {
    document.getElementById('fechaSelect').value = '';
    renderCitas(null);
  });

  function renderStats(citas) {
    document.getElementById('statTotal').textContent = citas.length;
    document.getElementById('statProgramadas').textContent = citas.filter(c => c.estado === 'programada').length;
    document.getElementById('statCompletadas').textContent = citas.filter(c => c.estado === 'completada').length;
    document.getElementById('statCanceladas').textContent = citas.filter(c => c.estado === 'cancelada').length;
  }

  function renderCitas(filtroFecha) {
    const container = document.getElementById('citasContainer');
    const citas = filtroFecha
      ? todasLasCitas.filter(c => c.fecha === filtroFecha)
      : todasLasCitas;

    if (citas.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
          <div class="w-16 h-16 bg-gray-50 border border-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <p class="text-gray-500 font-medium">No hay citas${filtroFecha ? ' para esta fecha' : ' registradas'}</p>
        </div>
      `;
      return;
    }

    // Agrupar por fecha
    const porFecha = {};
    citas.forEach(c => {
      if (!porFecha[c.fecha]) porFecha[c.fecha] = [];
      porFecha[c.fecha].push(c);
    });

    const estadoBadge = {
      'programada': `<span class="px-2.5 py-1 bg-teal-50 text-teal-700 border border-teal-100 rounded text-xs font-semibold uppercase tracking-wider">Programada</span>`,
      'completada': `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded text-xs font-semibold uppercase tracking-wider">Completada</span>`,
      'cancelada':  `<span class="px-2.5 py-1 bg-red-50 text-red-700 border border-red-100 rounded text-xs font-semibold uppercase tracking-wider">Cancelada</span>`,
      'no_asistio': `<span class="px-2.5 py-1 bg-amber-50 text-amber-700 border border-amber-100 rounded text-xs font-semibold uppercase tracking-wider">No Asistió</span>`
    };

    const getAcciones = (c) => {
      if (c.estado !== 'programada') return estadoBadge[c.estado] || '';
      return `
        <button onclick="actualizarEstado(${c.id},'completada')" class="px-4 py-2 bg-slate-900 text-white rounded-lg hover:bg-slate-800 text-sm font-medium transition-colors">Completar</button>
        <button onclick="actualizarEstado(${c.id},'no_asistio')" class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium transition-colors">No asistió</button>
        <button onclick="actualizarEstado(${c.id},'cancelada')" class="px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg text-sm font-medium transition-colors">Cancelar</button>
      `;
    };

    const formatFechaHeader = (fechaStr) => {
      const d = new Date(fechaStr + 'T00:00:00');
      if (fechaStr === today) return `Hoy — ${d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}`;
      return d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    };

    container.innerHTML = Object.keys(porFecha)
      .sort()
      .map(fecha => {
        const citasDelDia = porFecha[fecha].sort((a,b) => a.hora.localeCompare(b.hora));
        const esHoy = fecha === today;
        const esPasado = fecha < today;
        return `
          <div class="bg-white rounded-2xl shadow-sm border ${esHoy ? 'border-teal-200' : 'border-gray-100'} overflow-hidden">
            <div class="px-6 py-4 border-b ${esHoy ? 'bg-teal-50 border-teal-100' : esPasado ? 'bg-gray-50 border-gray-100' : 'bg-slate-50 border-gray-100'} flex items-center justify-between">
              <div class="flex items-center gap-3">
                ${esHoy ? `<span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse inline-block"></span>` : ''}
                <h3 class="font-semibold text-sm uppercase tracking-wider ${esHoy ? 'text-teal-800' : 'text-slate-700'}">${formatFechaHeader(fecha)}</h3>
              </div>
              <span class="text-xs font-medium text-gray-400">${citasDelDia.length} cita${citasDelDia.length !== 1 ? 's' : ''}</span>
            </div>
            <div class="divide-y divide-gray-50">
              ${citasDelDia.map(c => `
                <div class="flex flex-col md:flex-row md:items-center justify-between p-5 gap-4 hover:bg-gray-50/50 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-800 font-bold text-base shrink-0">
                      ${c.hora.substring(0,5)}
                    </div>
                    <div>
                      <p class="font-semibold text-gray-900 mb-0.5">${c.paciente?.first_name || ''} ${c.paciente?.last_name || ''}</p>
                      <p class="text-sm text-gray-500 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        ${c.paciente?.telefono || 'No registrado'}
                      </p>
                      ${c.motivo ? `<p class="text-xs text-gray-400 mt-1 truncate max-w-xs">${c.motivo}</p>` : ''}
                    </div>
                  </div>
                  <div class="flex flex-wrap items-center gap-2 md:justify-end">
                    ${getAcciones(c)}
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');
  }

  async function loadResumenCitas() {
    const res = await fetch(`${API}/citas/`, { headers });
    if (!res.ok) return;
    todasLasCitas = await res.json();
    todasLasCitas.sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora));
    renderStats(todasLasCitas);
    renderCitas(null);
  }

  window.actualizarEstado = async (id, estado) => {
    const res = await fetch(`${API}/citas/${id}/`, {
      method: 'PUT',
      headers,
      body: JSON.stringify({ estado, observaciones: '' })
    });
    if (res.ok) {
      await loadResumenCitas();
      const filtro = document.getElementById('fechaSelect').value;
      renderCitas(filtro || null);
      if (!vistaSemanal.classList.contains('hidden')) {
        loadWeeklyAgenda();
      }
    }
  };

  loadResumenCitas();

  // WEEKLY VIEW LOGIC
  const colors = ['bg-blue-50', 'bg-teal-50', 'bg-indigo-50', 'bg-purple-50', 'bg-cyan-50'];
  const borders = ['border-blue-200', 'border-teal-200', 'border-indigo-200', 'border-purple-200', 'border-cyan-200'];
  const texts = ['text-blue-800', 'text-teal-800', 'text-indigo-800', 'text-purple-800', 'text-cyan-800'];
  let citasSemanalesData = {};
  let currentWeekOffset = 0; // Offset in days

  function getMonday(d) {
    d = new Date(d);
    var day = d.getDay(),
        diff = d.getDate() - day + (day == 0 ? -6:1);
    return new Date(d.setDate(diff));
  }

  document.getElementById('btnSemanaAnterior').addEventListener('click', () => {
    currentWeekOffset -= 7;
    loadWeeklyAgenda();
  });
  
  document.getElementById('btnSemanaSiguiente').addEventListener('click', () => {
    currentWeekOffset += 7;
    loadWeeklyAgenda();
  });

  document.getElementById('btnSemanaActual').addEventListener('click', () => {
    currentWeekOffset = 0;
    loadWeeklyAgenda();
  });

  async function loadWeeklyAgenda() {
    const curr = new Date();
    curr.setDate(curr.getDate() + currentWeekOffset);
    const monday = getMonday(curr);
    
    let diasSemana = [];
    let promesasCitas = [];

    // Lunes a Viernes
    for(let i=0; i<5; i++) {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      const strDate = d.toISOString().split('T')[0];
      diasSemana.push({
        nombre: ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'][i],
        fecha: strDate
      });
      // Hacer requests por día
      promesasCitas.push(fetch(`${API}/citas/?fecha=${strDate}`, { headers }).then(r => r.json()));
    }

    document.getElementById('semanaRango').textContent = `Semana del ${diasSemana[0].fecha} al ${diasSemana[4].fecha}`;

    const citasPorDia = await Promise.all(promesasCitas);
    
    // Organizar citas por hora y día
    const horasTrabajo = [
      '08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00'
    ];
    
    const container = document.getElementById('gridContainer');
    let html = `
      <div class="border-b border-r border-gray-100 bg-slate-50 p-3"></div>
      ${diasSemana.map(d => `<div class="border-b border-r border-gray-100 bg-slate-50 p-3 flex flex-col items-center justify-center font-semibold text-[11px] tracking-widest text-slate-700 uppercase"><span class="mb-0.5">${d.nombre}</span><span class="text-slate-400 font-medium">${d.fecha.substring(5)}</span></div>`).join('')}
    `;

    citasSemanalesData = {};
    let colorIndex = 0;

    horasTrabajo.forEach((hora) => {
      html += `<div class="border-b border-r border-gray-100 bg-slate-50 h-20 flex items-center justify-center font-semibold text-xs text-slate-600">${hora}</div>`;
      
      diasSemana.forEach((diaInfo, dayIdx) => {
        const citasDelDia = citasPorDia[dayIdx] || [];
        const prefix = hora.split(':')[0];
        
        const citasEnFranja = citasDelDia.filter(c => c.hora.startsWith(prefix) && (c.estado === 'programada' || c.estado === 'completada'));
        
        if (citasEnFranja.length > 0) {
          const c = citasEnFranja[0];
          citasSemanalesData[c.id] = c;
          
          const idx = colorIndex % colors.length;
          const bgClass = colors[idx];
          const borderClass = borders[idx];
          const textClass = texts[idx];
          colorIndex++;
          
          html += `
            <div onclick="abrirModal(${c.id})" class="cursor-pointer border-b border-r border-gray-100 p-1.5 hover:bg-gray-50 transition-colors">
              <div class="h-full w-full ${bgClass} border ${borderClass} rounded-lg flex flex-col items-center justify-center ${textClass} hover:opacity-80 transition-opacity">
                <span class="text-[10px] font-bold mb-0.5">${c.hora.substring(0,5)}</span>
                <span class="text-[10px] font-semibold tracking-wide uppercase text-center px-1 truncate w-full">${c.paciente?.first_name || 'Paciente'}</span>
              </div>
            </div>
          `;
        } else {
          // Empty space
          html += `<div class="border-b border-r border-gray-100 bg-white hover:bg-slate-50/50 transition-colors"></div>`;
        }
      });
    });

    container.innerHTML = html;
  }

  // MODAL LOGIC
  const modal = document.getElementById('citaModal');
  const btnClose = document.getElementById('closeModal');
  const btnCerrarModal = document.getElementById('btnCerrarModal');
  const btnVerDiaria = document.getElementById('btnVerDiaria');

  window.abrirModal = (citaId) => {
    const cita = citasSemanalesData[citaId];
    if(!cita) return;

    const nombreCompleto = `${cita.paciente?.first_name || ''} ${cita.paciente?.last_name || ''}`.trim();
    document.getElementById('modalIniciales').textContent = nombreCompleto.substring(0, 1).toUpperCase() || 'P';
    document.getElementById('modalPaciente').textContent = nombreCompleto || 'Paciente Desconocido';
    document.getElementById('modalTelefono').textContent = `${cita.paciente?.telefono || 'Sin teléfono'}`;
    
    document.getElementById('modalFecha').textContent = cita.fecha;
    document.getElementById('modalHora').textContent = cita.hora.substring(0, 5);
    document.getElementById('modalMotivo').textContent = cita.motivo || 'Sin motivo registrado.';
    
    const spanEst = document.getElementById('modalEstado');
    spanEst.textContent = cita.estado;
    spanEst.className = `inline-block px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider ` + 
      (cita.estado === 'programada' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200');

    btnVerDiaria.onclick = () => {
      modal.classList.add('hidden');
      document.getElementById('fechaSelect').value = cita.fecha;
      loadCitasDiarias(cita.fecha);
      btnDiaria.click();
    };

    modal.classList.remove('hidden');
  };

  const closeModalFunc = () => modal.classList.add('hidden');
  btnClose.addEventListener('click', closeModalFunc);
  btnCerrarModal.addEventListener('click', closeModalFunc);
  
</script>
