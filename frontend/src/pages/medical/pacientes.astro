---
import MedicalLayout from '../../layouts/MedicalLayout.astro';
---

<MedicalLayout title="Directorio de Pacientes">
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-gray-900">Mis Pacientes</h1>
        <p class="text-gray-500 font-medium mt-1">Directorio de pacientes atendidos en sus consultas</p>
      </div>
      <div class="relative w-full sm:w-72">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input type="text" id="search" placeholder="Buscar paciente por nombre o email..." class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all shadow-sm outline-none font-medium text-gray-700" />
      </div>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
      <div id="pacientesContainer" class="divide-y divide-gray-100">
        <div class="p-16 text-center">
          <svg class="animate-spin h-8 w-8 mx-auto text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>
      </div>
    </div>
  </div>
</MedicalLayout>

<script>
  // @ts-nocheck
  const token = localStorage.getItem('token');
  const rol = localStorage.getItem('rol');
  
  if (!token || rol !== 'medico') {
    window.location.replace('/medical/login');
    throw new Error('No autorizado');
  }

  const API = 'http://localhost:8000/api';
  const headers = { 'Authorization': `Bearer ${token}` };
  let todasCitas = [];
  let pacientes = [];

  async function loadData() {
    const res = await fetch(`${API}/citas/`, { headers });
    todasCitas = await res.json();

    const pacientesMap = new Map();
    todasCitas.forEach(c => {
      if (c.paciente?.id && !pacientesMap.has(c.paciente.id)) {
        const citaCount = todasCitas.filter(ci => ci.paciente?.id === c.paciente.id).length;
        // Last appointment date
        const lastCita = todasCitas
          .filter(ci => ci.paciente?.id === c.paciente.id)
          .sort((a,b) => new Date(b.fecha) - new Date(a.fecha))[0];
        pacientesMap.set(c.paciente.id, { ...c.paciente, citasCount: citaCount, lastFecha: lastCita?.fecha });
      }
    });
    pacientes = Array.from(pacientesMap.values());
    renderPacientes(pacientes);
  }

  function renderPacientes(list) {
    const container = document.getElementById('pacientesContainer');
    if (list.length === 0) {
      container.innerHTML = `
        <div class="p-16 text-center bg-gray-50/50">
          <div class="w-16 h-16 bg-white border border-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          </div>
          <p class="text-gray-500 font-medium">No se encontraron pacientes registrados.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = list.map(p => `
      <div class="p-6 sm:px-8 sm:py-6 hover:bg-slate-50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-6 group">
        <div class="flex items-center gap-5">
          <div class="w-14 h-14 bg-teal-50 border border-teal-100 rounded-2xl flex items-center justify-center text-teal-700 font-bold text-xl shrink-0">
            ${(p.first_name?.[0] || '')}${(p.last_name?.[0] || '')}
          </div>
          <div>
            <h3 class="font-bold text-gray-900 text-lg group-hover:text-teal-700 transition-colors">${p.first_name} ${p.last_name}</h3>
            <div class="flex flex-wrap items-center gap-3 text-sm font-medium text-gray-500 mt-0.5">
              <span class="flex items-center gap-1.5 text-slate-600">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                ${p.email || 'Sin correo'}
              </span>
              <span class="text-gray-300">•</span>
              <span class="flex items-center gap-1.5 text-slate-600">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                ${p.telefono || 'Sin teléfono'}
              </span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-4 border-t border-gray-100 sm:border-0 pt-4 sm:pt-0 shrink-0">
          <div class="text-right hidden sm:block">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Última Cita</p>
            <p class="text-sm font-medium text-gray-700 mt-0.5">${p.lastFecha ? new Date(p.lastFecha + 'T00:00:00').toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric'}) : 'N/A'}</p>
          </div>
          <span class="px-3.5 py-1.5 bg-slate-100 text-slate-700 border border-slate-200 rounded-lg text-xs font-bold uppercase tracking-widest whitespace-nowrap">${p.citasCount} ${p.citasCount === 1 ? 'Cita' : 'Citas'}</span>
        </div>
      </div>
    `).join('');
  }

  document.getElementById('search').addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase();
    const filtered = pacientes.filter(p => 
      (p.first_name + ' ' + p.last_name).toLowerCase().includes(term) ||
      (p.email || '').toLowerCase().includes(term)
    );
    renderPacientes(filtered);
  });

  loadData();
</script>