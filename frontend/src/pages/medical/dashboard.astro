---
import MedicalLayout from '../../layouts/MedicalLayout.astro';
---

<MedicalLayout title="Panel Médico">
  <div class="max-w-6xl mx-auto space-y-8">
    <!-- Header/Bienvenida -->
    <div class="bg-slate-900 rounded-2xl p-8 text-white shadow-sm flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight mb-2">Bienvenido, Doctor</h1>
        <p class="text-slate-400 font-medium">Resumen de actividad y próximas citas</p>
      </div>
      <div class="hidden md:block">
        <svg class="w-12 h-12 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      </div>
    </div>

    <!-- Stats rápidas -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col justify-center">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Próximas Citas</p>
        <p class="text-4xl font-light text-slate-800" id="citasTotal">-</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col justify-center">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Completadas</p>
        <p class="text-4xl font-light text-teal-600" id="completadas">-</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col justify-center">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Pendientes Totales</p>
        <p class="text-4xl font-light text-amber-600" id="pendientes">-</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col justify-center">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Pacientes Atendidos</p>
        <p class="text-4xl font-light text-indigo-600" id="pacientesUnicos">-</p>
      </div>
    </div>

    <!-- Próximas Citas -->
    <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">
      <div class="flex justify-between items-end mb-8 border-b border-gray-100 pb-6">
        <div>
          <h2 class="text-2xl font-semibold text-gray-900 tracking-tight">Próximas Citas</h2>
          <p class="text-sm text-gray-500 mt-1">Lista de atenciones pendientes</p>
        </div>
        <span id="todayDate" class="text-sm font-medium text-gray-400 uppercase tracking-wider"></span>
      </div>
      
      <div id="citasContainer" class="space-y-4">
        <div class="text-center py-12 text-gray-400">
          <svg class="animate-spin h-8 w-8 mx-auto text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>
      </div>
    </div>
  </div>
</MedicalLayout>

<script>
  // @ts-nocheck
  const token = localStorage.getItem('token');
  const rol = localStorage.getItem('rol');
  
  if (!token || rol !== 'medico') {
    window.location.replace('/medical/login');
    throw new Error('No autorizado');
  }

  const API = 'http://localhost:8000/api';
  const headers = { 'Authorization': `Bearer ${token}` };
  const today = new Date().toISOString().split('T')[0];
  
  document.getElementById('todayDate').textContent = new Date().toLocaleDateString('es-ES', { 
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
  });

  async function loadDashboard() {
    const res = await fetch(`${API}/citas/`, { headers });
    const todasCitas = await res.json();

    const pendientes = todasCitas.filter(c => c.estado === 'programada');
    const completadas = todasCitas.filter(c => c.estado === 'completada');
    const uniquePacientes = [...new Set(todasCitas.map(c => c.paciente?.id))].length;

    const proximasCitas = todasCitas
      .filter(c => c.fecha >= today && c.estado === 'programada')
      .sort((a, b) => new Date(a.fecha + 'T' + a.hora) - new Date(b.fecha + 'T' + b.hora))
      .slice(0, 10);

    document.getElementById('citasTotal').textContent = proximasCitas.length;
    document.getElementById('completadas').textContent = completadas.length;
    document.getElementById('pendientes').textContent = pendientes.length;
    document.getElementById('pacientesUnicos').textContent = uniquePacientes;

    const container = document.getElementById('citasContainer');

    if (proximasCitas.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16">
          <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-1">Agenda Despejada</h3>
          <p class="text-gray-500">No tienes citas programadas próximamente.</p>
        </div>
      `;
      return;
    }

    const getEstadoActions = (c) => ({
      'programada': `<button onclick="actualizarEstado(${c.id}, 'completada')" class="px-5 py-2.5 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-slate-800 transition">Completar Consulta</button>
                     <button onclick="actualizarEstado(${c.id}, 'no_asistio')" class="px-5 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition">Marcar Inasistencia</button>`
    })[c.estado] || '';

    const formatFecha = (fechaStr) => {
      if (fechaStr === today) return 'Hoy';
      const d = new Date(fechaStr + 'T00:00:00');
      return d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
    };

    container.innerHTML = proximasCitas.map(c => `
      <div class="flex flex-col sm:flex-row sm:items-center justify-between p-6 bg-white border border-gray-100 rounded-xl hover:border-gray-200 transition-colors shadow-sm gap-6">
        <div class="flex items-start gap-6">
          <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-xl flex flex-col items-center justify-center text-slate-800 shrink-0">
            <span class="text-[10px] font-semibold uppercase tracking-widest text-slate-500 mb-0.5">${formatFecha(c.fecha)}</span>
            <span class="font-bold text-lg">${c.hora.substring(0,5)}</span>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-1">${c.paciente?.first_name || ''} ${c.paciente?.last_name || ''}</h3>
            <div class="flex items-center gap-4 text-sm text-gray-500">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                ${c.paciente?.telefono || 'N/A'}
              </span>
            </div>
            ${c.motivo ? `<div class="mt-3 bg-gray-50 rounded-lg p-3 text-sm text-gray-600 border border-gray-100"><span class="font-medium text-gray-900">Motivo:</span> ${c.motivo}</div>` : ''}
          </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          ${getEstadoActions(c)}
        </div>
      </div>
    `).join('');
  }

  window.actualizarEstado = async (id, estado) => {
    const res = await fetch(`${API}/citas/${id}/`, {
      method: 'PUT',
      headers,
      body: JSON.stringify({ estado, observaciones: '' })
    });

    if (res.ok) {
      loadDashboard();
    } else {
      alert('Error al actualizar');
    }
  };

  loadDashboard();
</script>