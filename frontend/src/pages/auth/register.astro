---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Registro - Sistema de Citas Médicas">
  <div class="min-h-screen flex items-center justify-center bg-gray-50 relative overflow-hidden py-10">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-teal-100 rounded-full blur-3xl opacity-50"></div>
    <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-slate-200 rounded-full blur-3xl opacity-60"></div>

    <div class="w-full max-w-xl p-8 md:p-10 bg-white rounded-[2rem] shadow-sm border border-gray-100 z-10 mx-4">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-teal-50 text-teal-600 mb-4 border border-teal-100">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">Crear una cuenta</h1>
        <p class="text-gray-500 mt-2 text-sm">Regístrate para gestionar tus citas en el SGSSS</p>
      </div>

      <form id="registerForm" class="space-y-5">
        <!-- Nombre y Apellido -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre</label>
            <input type="text" name="first_name" required
              class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 focus:border-slate-900 outline-none transition-all text-gray-700 font-medium"
              placeholder="Juan" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Apellido</label>
            <input type="text" name="last_name" required
              class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 focus:border-slate-900 outline-none transition-all text-gray-700 font-medium"
              placeholder="Pérez" />
          </div>
        </div>

        <!-- Documento -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Documento de identidad</label>
          <div class="grid grid-cols-3 gap-3">
            <select name="tipo_documento"
              class="col-span-1 px-3 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 outline-none transition-all text-gray-700 font-medium">
              <option value="CC">CC</option>
              <option value="TI">TI</option>
              <option value="CE">CE</option>
              <option value="PA">PA</option>
            </select>
            <input type="text" name="numero_documento" required
              class="col-span-2 px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 focus:border-slate-900 outline-none transition-all text-gray-700 font-medium"
              placeholder="Número de documento" />
          </div>
          <p class="text-xs text-gray-400 mt-1 ml-1">CC: Cédula · TI: Tarjeta Identidad · CE: Cédula Extranjería · PA: Pasaporte</p>
        </div>

        <!-- Correo electrónico -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Correo electrónico</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <input type="email" name="email" required
              class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 focus:border-slate-900 outline-none transition-all text-gray-700 font-medium"
              placeholder="correo@ejemplo.com" />
          </div>
        </div>

        <!-- Teléfono -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Teléfono / celular</label>
          <input type="tel" name="telefono"
            class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 focus:border-slate-900 outline-none transition-all text-gray-700 font-medium"
            placeholder="300 000 0000" />
        </div>

        <!-- EPS y Régimen -->
        <div class="p-4 bg-teal-50 rounded-2xl border border-teal-100 space-y-4">
          <p class="text-sm font-semibold text-teal-800 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            Información de afiliación SGSSS
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">EPS</label>
              <select name="eps_id" id="epsSelect"
                class="w-full px-4 py-3.5 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 outline-none transition-all text-gray-700 font-medium">
                <option value="">Seleccionar EPS...</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Régimen</label>
              <select name="regimen"
                class="w-full px-4 py-3.5 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-slate-900 outline-none transition-all text-gray-700 font-medium">
                <option value="">Seleccionar régimen...</option>
                <option value="contributivo">Contributivo</option>
                <option value="subsidiado">Subsidiado</option>
              </select>
            </div>
          </div>
          <p class="text-xs text-teal-600">
            Contributivo: cotizante o beneficiario · Subsidiado: población sin capacidad de pago
          </p>
        </div>

        <!-- Contraseña -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Contraseña</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <input type="password" name="password" id="passwordInputReg" required minlength="6"
              class="w-full pl-11 pr-11 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-slate-900 focus:border-slate-900 outline-none transition-all text-gray-700 font-medium"
              placeholder="••••••••" />
            <button type="button" id="togglePasswordReg"
              class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none">
              <svg id="eyeIconReg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              <svg id="eyeOffIconReg" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
              </svg>
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-2 ml-1">Mínimo 6 caracteres</p>
        </div>

        <input type="hidden" name="rol" value="paciente" />

        <button type="submit" id="submitBtnReg"
          class="w-full py-4 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-800 transition-all shadow-sm flex items-center justify-center gap-2 mt-4 text-lg">
          <span>Crear Cuenta</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <div id="registerError" class="hidden items-center gap-2 p-3 text-sm text-red-600 bg-red-50 rounded-lg">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="error-text"></span>
        </div>
      </form>

      <div class="mt-8 text-center space-y-4">
        <p class="text-sm text-gray-600">
          ¿Ya tienes una cuenta?
          <a href="/auth/login" class="text-teal-600 font-bold hover:text-teal-700 transition">Inicia sesión</a>
        </p>
        <a href="/" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-800 transition">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const API = window.__API__;

  // Load EPS list
  async function loadEPS() {
    try {
      const res = await fetch(`${API}/eps/?activas=true`);
      const epsList = await res.json();
      const select = document.getElementById('epsSelect') as HTMLSelectElement;
      epsList.forEach((eps: { id: number; nombre: string }) => {
        const opt = document.createElement('option');
        opt.value = String(eps.id);
        opt.textContent = eps.nombre;
        select.appendChild(opt);
      });
    } catch {
      // silently ignore if API not available
    }
  }
  loadEPS();

  // Toggle password
  const togglePasswordBtn = document.getElementById('togglePasswordReg');
  const passwordInput = document.getElementById('passwordInputReg') as HTMLInputElement;
  const eyeIcon = document.getElementById('eyeIconReg');
  const eyeOffIcon = document.getElementById('eyeOffIconReg');
  togglePasswordBtn?.addEventListener('click', () => {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    eyeIcon?.classList.toggle('hidden');
    eyeOffIcon?.classList.toggle('hidden');
  });

  const form = document.getElementById('registerForm') as HTMLFormElement;
  const errorContainer = document.getElementById('registerError');
  const errorText = errorContainer?.querySelector('.error-text');
  const submitBtn = document.getElementById('submitBtnReg') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data: Record<string, unknown> = Object.fromEntries(formData);

    // Clean empty optional fields
    if (!data.eps_id) delete data.eps_id;
    if (!data.regimen) delete data.regimen;
    if (!data.numero_documento) delete data.numero_documento;

    const originalBtnHtml = submitBtn.innerHTML;
    submitBtn.innerHTML = '<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Procesando...</span>';
    submitBtn.disabled = true;
    errorContainer?.classList.add('hidden');

    try {
      const res = await fetch(`${API}/auth/register/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const json = await res.json();

      if (res.ok) {
        window.location.href = '/auth/login?registered=1';
      } else {
        const msg = json.error || JSON.stringify(json);
        errorText!.textContent = typeof msg === 'string' ? msg : 'Error en la validación de datos.';
        errorContainer!.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    } catch {
      errorText!.textContent = 'No se pudo conectar con el servidor. Intente más tarde.';
      errorContainer!.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnHtml;
    }
  });
</script>
