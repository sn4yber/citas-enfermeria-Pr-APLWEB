---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;
---

<BaseLayout title={title}>
  <div class="flex min-h-screen bg-gray-50">
    <!-- Sidebar -->
    <aside class="w-64 bg-white shadow-lg flex flex-col">
      <div class="p-6 border-b">
        <h1 class="text-xl font-bold text-slate-900">Citas Médicas</h1>
        <p class="text-xs text-gray-500">Panel del Paciente</p>
      </div>

      <nav class="flex-1 p-4 space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-600 hover:bg-slate-50 hover:text-slate-900 transition text-sm font-medium">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Inicio
        </a>

        <div class="pt-3 pb-1 px-4">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Atención Médica</p>
        </div>

        <a href="/dashboard/agendar" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-600 hover:bg-slate-50 hover:text-slate-900 transition text-sm font-medium">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
          Agendar Consulta
        </a>
        <a href="/dashboard/ordenes" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-600 hover:bg-teal-50 hover:text-teal-800 transition text-sm font-medium">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Mis Órdenes
          <span id="navOrdenesCount" class="ml-auto hidden text-xs font-bold bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded-full"></span>
        </a>
        <a href="/dashboard/citas" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-600 hover:bg-slate-50 hover:text-slate-900 transition text-sm font-medium">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          Historial de Citas
        </a>
      </nav>

      <div class="p-4 border-t">
        <button id="logoutBtn" class="flex items-center gap-3 px-4 py-3 w-full text-left rounded-lg text-red-600 hover:bg-red-50 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          Cerrar Sesión
        </button>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 p-8 overflow-y-auto">
      <slot />
    </main>
  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    localStorage.clear();
    window.location.href = '/auth/login';
  });

  // Highlight active nav link
  const path = window.location.pathname;
  document.querySelectorAll('nav a').forEach(a => {
    if (a.getAttribute('href') === path) {
      a.classList.add('bg-slate-900', 'text-white');
      a.classList.remove('text-gray-600', 'hover:bg-slate-50', 'hover:text-slate-900', 'hover:bg-teal-50', 'hover:text-teal-800');
    }
  });

  // Badge: pending ordenes
  const token = localStorage.getItem('token');
  if (token) {
    fetch('http://localhost:8000/api/ordenes-medicas/', { headers: { Authorization: `Bearer ${token}` } })
      .then(r => r.json())
      .then(ordenes => {
        const pendientes = ordenes.filter(o => o.estado === 'autorizada' && o.autorizacion?.estado === 'aprobada').length;
        const badge = document.getElementById('navOrdenesCount');
        if (badge && pendientes > 0) {
          badge.textContent = pendientes;
          badge.classList.remove('hidden');
        }
      }).catch(() => {});
  }
</script>